# Um editor, um estilo. Sem discussão em pull request.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,webp,avif,woff,woff2}]
insert_final_newline = false
